{
	"schemaVersion": 1,
	"id": "opacui",
	"version": "${version}",
	"name": "OPAC UI",
	"description": "A Fabric client-side GUI addon for Open Parties and Claims, providing a full party management screen.",
	"authors": [
		"mervyn"
	],
	"contact": {
		"sources": "https://github.com/mervyn/opacui"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/opacui/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"mervyn.opacui.fabric.OpacUiFabric"
		],
		"client": [
			"mervyn.opacui.fabric.client.OpacUiFabricClient"
		]
	},
	"mixins": [
		"opacui.common.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"openpartiesandclaims": "*",
		"cloth-config": "*"
	}
}
