{
	"schemaVersion": 1,
	"id": "opacui",
	"version": "${version}",
	"name": "OPAC UI",
	"description": "A Fabric client-side GUI addon for Open Parties and Claims, providing a full party management screen.",
	"authors": [
		"mervyn"
	],
	"contact": {
		"sources": "https://github.com/mervyn/opacui"
	},
	"license": "LGPL-3.0-only",
	"icon": "assets/opacui/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"mervyn.opacui.OpacUiMod"
		],
		"client": [
			"mervyn.opacui.client.OpacUiModClient"
		]
	},
	"mixins": [
		"opacui.mixins.json",
		{
			"config": "opacui.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*",
		"openpartiesandclaims": "*",
		"cloth-config": "*"
	}
}